.config-slot {
    margin-bottom: 16px;
    &-name {
        line-height: 20px;
        margin-bottom: 6px;
        font-size: 12px;
        color: #4D4F56;
        span {
          display: inline-block;
          cursor: pointer;
          font-weight: bold;
          &:hover {
            border-radius: 2px;
            color: #313238;
            background-color: #D8DFF0;
          }
        }
    }
    &-content {
      padding: 10px;
      border: 1px solid #c4c6cc;
      border-radius: 2px;
      max-height: 200px;
      overflow: auto;
    }
}

.slot-tip-content {
  width: 400px;
  padding: 12px;
  .slot-tip-bg {
    display: flex;
    align-items: center;
    line-height: 24px;
    padding: 0 12px;
    & > span:first-child {
      width: 48px;
      color: #979BA5;
      margin-right: 3px;
    }
    & > span:last-child {
      flex: 1;
      color: #4D4F56;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
  .even-bg {
    background-color: #F5F7FA;
    border-radius: 2px;
  }
}